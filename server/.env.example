# ==========================================
# Wayfound Backend Environment Variables (Example)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.qukmwlh.mongodb.net/wayfound?retryWrites=true&w=majority&appName=Cluster0

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_here

# Optional: Cloudinary (for stay image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
